# NEXIS Web Client Environment Variables
# In Vite, client-side environment variables must be prefixed with VITE_

# OpenCelliD API Token (Free token from https://opencellid.org)
VITE_OPENCELLID_API_KEY=

# Supabase Client Configuration (Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
